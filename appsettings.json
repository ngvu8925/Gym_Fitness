{
  "ConnectionStrings": {
    "_Comment": "Connection string đặt trong user secrets: dotnet user-secrets set ConnectionStrings:DefaultConnection <value>"
  },
  "JwtSettings": {
    "_Comment": "SecretKey/Issuer/Audience/ExpiryMinutes đặt trong user secrets: dotnet user-secrets set JwtSettings:<Key> <value>"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7003",
      "http://localhost:7003"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
